<%@ page pageEncoding="UTF-8" %>
<label>Rua
    <input type="text" name="rua" placeholder="Ex.: Rua das Flores" required maxlength="150" value="<c:out value='${vRua}'/>">
</label>
<div class="linha">
    <label>Número
        <input type="text" name="numero" placeholder="Ex.: 123" required maxlength="20" value="<c:out value='${vNumero}'/>">
    </label>
    <label>Bairro
        <input type="text" name="bairro" placeholder="Ex.: Centro" required maxlength="100" value="<c:out value='${vBairro}'/>">
    </label>
    <label>CEP
        <input type="text" name="cep" required maxlength="8" placeholder="00000-000" inputmode="numeric" pattern="\d{8}" title="CEP com 8 dígitos (somente números)" oninput="this.value=this.value.replace(/\D/g,'')" value="<c:out value='${vCep}'/>">
    </label>
</div>
<div class="linha">
    <label>Cidade
        <input type="text" name="cidade" placeholder="Ex.: São Paulo" required maxlength="100" value="<c:out value='${vCidade}'/>">
    </label>
    <label>Estado
        <select name="estado" required>
            <option value="">Selecione</option>
            <c:forTokens var="uf" items="AC,AL,AP,AM,BA,CE,DF,ES,GO,MA,MT,MS,MG,PA,PB,PR,PE,PI,RJ,RN,RS,RO,RR,SC,SP,SE,TO" delims=",">
                <option value="${uf}" ${vEstado == uf ? 'selected' : ''}>${uf}</option>
            </c:forTokens>
        </select>
    </label>
</div>
